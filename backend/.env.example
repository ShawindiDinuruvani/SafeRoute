# SafeRoute Backend Environment Variables Template

# Spring Profile (dev | prod)
SPRING_PROFILES_ACTIVE=prod

# Server Port
PORT=8080

# Production PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/saferoute
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password
DB_DRIVER=org.postgresql.Driver

# Security JWT Secret Key (Base64 encoded string, min 256 bits)
JWT_SECRET=your_base64_encoded_secret_key_change_in_production
JWT_EXPIRATION_MS=86400000
